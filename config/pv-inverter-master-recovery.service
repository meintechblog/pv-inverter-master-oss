[Unit]
Description=PV-Inverter-Proxy Boot-Time Recovery (SAFETY-04)
Documentation=https://github.com/meintechblog/pv-inverter-master-oss
DefaultDependencies=yes
After=local-fs.target
Before=pv-inverter-master.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/pv-inverter-master/.venv/bin/python3 -m pv_inverter_master.recovery
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pv-inverter-master-recovery

[Install]
RequiredBy=pv-inverter-master.service
