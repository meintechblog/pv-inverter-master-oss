[Unit]
Description=Watch for pv-inverter-master update triggers (Phase 45, EXEC-03)
Documentation=https://github.com/meintechblog/pv-inverter-master-oss
# Intentionally NO Requires=/PartOf=/BindsTo= the main service unit.
# This .path unit must remain active across main-service restarts so
# the .service it activates can restart the main service without
# being killed as part of the main service's cgroup.

[Path]
PathModified=/etc/pv-inverter-master/update-trigger.json
Unit=pv-inverter-master-updater.service

[Install]
WantedBy=multi-user.target
